<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Debug-only overlay. Points the app at the cleartext allow-list in
      src/debug/res/xml so the dev flavor can reach a local Next.js server.

      This attribute is deliberately NOT in src/main: putting it there would
      ship the exception in the release build, where the only reachable API is
      https and no cleartext should ever be permitted.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig"
        xmlns:tools="http://schemas.android.com/tools" />
</manifest>
